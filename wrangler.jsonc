{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corecare-care",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "care.corecaresystems.co.uk", "custom_domain": true }],
  "main": "src/index.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/platform-access",
			"/auth/portal-login",
			"/auth/portal-claim"
		]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "services": [
    {
      "binding": "CORECARE_PLATFORM",
      "service": "corecare-platform"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CLIENT_FILES",
      "bucket_name": "corecare-care-secure-files"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corecare",
      "database_id": "9d9bfe9a-ee79-48e7-817a-cadff90ccfcf"
    },
    {
      "binding": "CONTROL_DB",
      "database_name": "corecare-care-control",
      "database_id": "1e50a826-7976-4056-9e0f-54d2f4842b20",
      "migrations_dir": "control-migrations"
    }
  ],
  "vars": {
    "PLATFORM_ORIGIN": "https://owner.corecaresystems.co.uk",
    "ENVIRONMENT": "production"
  },
  "env": {
    "staging": {
      "name": "corecare-care-staging",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "services": [
        { "binding": "CORECARE_PLATFORM", "service": "corecare-platform-staging" }
      ],
      "r2_buckets": [
        { "binding": "CLIENT_FILES", "bucket_name": "corecare-care-staging-secure-files" }
      ],
      "d1_databases": [
        { "binding": "DB", "database_name": "corecare-care-staging-db", "database_id": "5c295bdf-4ea2-4550-a5d2-bd8c981994f6", "migrations_dir": "migrations" },
        { "binding": "CONTROL_DB", "database_name": "corecare-care-staging-control-db", "database_id": "9c4e311a-483d-4fed-8d11-cde0c65547c2", "migrations_dir": "control-migrations" }
      ],
      "vars": {
        "PLATFORM_ORIGIN": "https://corecare-platform-staging.workers.dev",
        "ENVIRONMENT": "staging"
      }
    }
  }
}
