{
  "name": "corecare",
  "version": "1.15.5",
  "private": true,
  "description": "CoreCare multi-tenant care management SaaS platform",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply corecare --local",
    "db:migrate:remote": "wrangler d1 migrations apply corecare --remote"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=20"
  }
}
