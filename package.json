{
  "name": "corecare",
  "version": "0.4.1",
  "private": true,
  "description": "CoreCare cloud care management platform \u2014 Cloudflare D1 foundation",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply corecare --local",
    "db:migrate:remote": "wrangler d1 migrations apply corecare --remote"
  },
  "devDependencies": {
    "wrangler": "^4.26.1"
  },
  "engines": {
    "node": ">=20"
  }
}
